# HotelPulse environment
# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- SerpApi (required for live review fetches; not needed once cached) ---
SERPAPI_API_KEY=

# --- Free LLM keys (Phase 2 tagging) ---
# Provide at least ONE. Gemini is preferred when both are set.
# Force a provider with LLM_PROVIDER=gemini or LLM_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_PROVIDER=

# --- Models (free providers) ---
TAG_MODEL=gemini-3.1-flash-lite
WRITE_MODEL=gemini-3.1-flash-lite

# --- Storage ---
DB_PATH=data/hotelpulse.db

# --- Credit budget protection ---
# Free plan: 250 searches/month AND 50 searches/hour. Keep these low.
MAX_REVIEWS_OWN=30
MAX_REVIEWS_COMPETITOR=10

# Hard guard rails (optional, shown for tuning)
SERP_MONTHLY_BUDGET=250
SERP_HOURLY_BUDGET=50
MAX_PAGES_OWN=8
MAX_PAGES_COMPETITOR=3
